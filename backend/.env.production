# ========================================
# تنظیمات پروداکشن - چابکان
# ========================================

PORT=5000

# آدرس MongoDB ابری (از چابکان یا MongoDB Atlas)
MONGO_URI=mongodb://USER:PASS@SERVER:PORT/?authSource=admin

# آدرس فرانت‌اند
FRONTEND_URL=https://amclothing.ir

# امنیت
JWT_SECRET=یک رمز قوی اینجا بذارید
JWT_EXPIRES_IN=7d

# Cookie - در پروداکشن حتماً true باشه
COOKIE_SECURE=true
COOKIE_SAME_SITE=none
